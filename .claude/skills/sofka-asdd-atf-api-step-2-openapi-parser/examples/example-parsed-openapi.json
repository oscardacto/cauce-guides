  "endpoints": [
    {
      "method": "POST",
      "path": "/osf/api/v1/pending-billing-quotas",
      "operation_id": "createBillingRequest",
      "summary": "Registra una solicitud de facturación",
      "description": "Crea una nueva solicitud o actualiza una existente según unicidad de cycle+distributorId+billingPeriod+periodProcessDate",
      "in_wi_scope": true,
      "request": {
        "content_type": "application/json",
        "body_schema_ref": "#/components/schemas/BillingRequest",
        "body_schema_resolved": {
          "type": "object",
          "required": ["cycle", "distributorId", "billingPeriod", "periodProcessDate"],
          "properties": {
            "cycle": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$", "example": "2026-05"},
            "distributorId": {"type": "string", "example": "DIST-001"},
            "billingPeriod": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$", "example": "2026-05"},
            "periodProcessDate": {"type": "string", "format": "date", "example": "2026-05-21"},
            "contractId": {"type": "string", "nullable": true, "example": "CTR-12345"}
          }
        },
        "required_fields": ["cycle", "distributorId", "billingPeriod", "periodProcessDate"],
        "examples": [
          {
            "name": "valid-request",
            "value": {"cycle": "2026-05", "distributorId": "DIST-001", "billingPeriod": "2026-05", "periodProcessDate": "2026-05-21"}
          }
        ]
      },
      "parameters": {"path": [], "query": [], "header": []},
      "responses": [
        {
          "status": 201,
          "description": "Solicitud creada en estado PENDING",
          "schema_ref": "#/components/schemas/BillingRequestCreated",
          "schema_resolved": {
            "type": "object",
            "required": ["requestId", "status", "createdAt"],
            "properties": {
              "requestId": {"type": "string", "format": "uuid"},
              "status": {"type": "string", "enum": ["PENDING"]},
              "createdAt": {"type": "string", "format": "date-time"}
            }
          },
          "examples": [],
          "error_codes": []
        },
        {
          "status": 400,
          "description": "Solicitud inválida",
          "schema_ref": "#/components/responses/BadRequest",
          "schema_resolved": {"type": "object", "properties": {"error": {"type": "string"}, "message": {"type": "string"}}},
          "error_codes": ["INVALID_CYCLE_DATE", "MISSING_REQUIRED_FIELD", "INVALID_FORMAT"]
        }
      ],
      "auth_required": false,
      "auth_type": "none"
    }
  ],
