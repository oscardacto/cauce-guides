import { APIRequestContext, APIResponse } from '@playwright/test';

export interface ApiCallOptions {
  method: 'GET' | 'POST' | 'PUT' | 'DELETE' | 'PATCH';
  url: string;
  headers?: Record<string, string>;
  query?: Record<string, string | number | boolean>;
  body?: unknown;
  expectedStatus?: number;
  cpId?: string;
  wiId?: string;
}

export interface ApiCallResult {
  status: number;
  headers: Record<string, string>;
  body: unknown;
  timings: {
    requestSentAt: string;
    responseReceivedAt: string;
    durationMs: number;
  };
}

/**
 * Cliente HTTP envoltorio sobre APIRequestContext de Playwright.
 * Captura timings, normaliza errores, prepara evidencia para shared-evidence-collector.
 *
 * IMPORTANTE: No incluir headers de auth aquí en duro — venir siempre por opts.headers
 * resuelto desde credentials-loader.ts al inicio del spec.
 */
export class ApiClient {
  constructor(private readonly request: APIRequestContext) {}

  async call(opts: ApiCallOptions): Promise<ApiCallResult> {
    const requestSentAt = new Date().toISOString();
    const t0 = performance.now();

    let response: APIResponse;
    try {
      response = await this.request.fetch(opts.url, {
        method: opts.method,
        headers: opts.headers,
        params: opts.query,
        data: opts.body,
      });
    } catch (err) {
      throw new Error(`[${opts.cpId ?? 'unknown'}] Network failure: ${(err as Error).message}`);
    }

    const responseReceivedAt = new Date().toISOString();
    const durationMs = Math.round(performance.now() - t0);

    const status = response.status();
    const headers = response.headers();

    let body: unknown;
    const contentType = headers['content-type'] ?? '';
    if (contentType.includes('application/json')) {
      try {
        body = await response.json();
      } catch {
        body = await response.text();
      }
    } else {
      body = await response.text();
    }

    return {
      status,
      headers,
      body,
      timings: { requestSentAt, responseReceivedAt, durationMs },
    };
  }
}
