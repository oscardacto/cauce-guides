{
  "name": "atf-api-automation-{run-id}",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Paquete de automatización API generado por ATF API v3",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:critical": "playwright test --grep @critical-flow",
    "test:report": "playwright show-report ../reports/playwright-html",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
