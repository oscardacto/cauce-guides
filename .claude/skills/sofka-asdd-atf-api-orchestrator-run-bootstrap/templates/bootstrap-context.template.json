{
  "$schema": "Contexto inicial devuelto por orchestrator-run-bootstrap al orquestador",
  "run_id": "{run_id derivado o pre-asignado}",
  "session_config_ref": "ver shared-config-loader output (no duplicar aquí)",
  "inputs_inventory": [
    {
      "src_id": "SRC-NNN",
      "path": "{relative path}",
      "type": "hu | openapi | postman | other | session_config",
      "utility": "high | medium | low",
      "size_bytes": 0,
      "format": "md | txt | docx | pdf | yaml | json",
      "observations": "{notas relevantes detectadas en lectura preliminar}"
    }
  ],
  "baseline_validation": {
    "applies": "{boolean — false en baseline, true en regression/fast-track/retest}",
    "baseline_run_id": "{string|null}",
    "baseline_path": "docs/output/{baseline_run_id}",
    "baseline_status": "completed | in_progress | blocked | missing",
    "defect_id_validated": "{string|null — solo retest}"
  },
  "cycle_type_detected": "baseline | regression | fast-track | retest",
  "issues": [
    {
      "id": "{CONFIG-WARN-NNN | BOOT-NNN}",
      "severity": "blocker | error | warning | info",
      "description": "{1 frase}",
      "suggested_action": "{1 frase}"
    }
  ],
  "ready_to_partition": "{boolean — true si se puede invocar work-item-partitioner}",
  "next_recommended_skill": "sofka-asdd-atf-api-orchestrator-work-item-partitioner",
  "generated_at": "{ISO 8601}"
}
