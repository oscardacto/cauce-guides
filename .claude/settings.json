{
    "env": {
        "ASDD_GITFLOW_PREFIXES": "feature/,feat/,fix/,hotfix/,chore/,refactor/,test/,docs/,perf/,ci/,wt/"
    },
    "permissions": {
        "allow": [
            "Bash(git status:*)",
            "Bash(git log:*)",
            "Bash(git diff:*)",
            "Bash(git branch:*)",
            "Bash(git show:*)",
            "Bash(git -C * status:*)",
            "Bash(ls:*)",
            "Bash(find:*)",
            "Bash(grep:*)",
            "Bash(rg:*)",
            "Bash(cat:*)",
            "Bash(head:*)",
            "Bash(tail:*)",
            "Bash(wc:*)",
            "Bash(tree:*)",
            "Bash(node .claude/scripts/asdd-artifact-name.mjs:*)",
            "Bash(node .claude/scripts/asdd-commit-authorization.mjs issue:*)",
            "Bash(node .claude/scripts/asdd-load-capability.mjs:*)",
            "Bash(node .claude/scripts/asdd-plan-authorization.mjs issue:*)",
            "Bash(node .claude/scripts/asdd-resolve-capability.mjs:*)",
            "Bash(node .claude/scripts/asdd-resolve-rule.mjs:*)",
            "Bash(node .claude/scripts/asdd-route-request.mjs --file:*)",
            "Bash(node .claude/scripts/asdd-run-bootstrap.mjs:*)",
            "Bash(node .claude/scripts/validate-template.mjs:*)",
            "Bash(node --version:*)",
            "Bash(npm --version:*)",
            "Bash(npm list:*)",
            "Bash(npm ci:*)",
            "Bash(npm run validate:*)",
            "Bash(npm run test:*)",
            "Bash(npm test:*)",
            "Bash(git --version:*)",
            "Bash(git mv:*)",
            "Bash(mv:*)",
            "Bash(which:*)",
            "Bash(where:*)",
            "Bash(git add:*)",
            "Read(*)",
            "Grep(*)",
            "Glob(*)",
            "Write(*)",
            "Edit(*)",
            "Bash(powershell -c \u0027 *)"
        ],
        "deny": [
            "Bash(rm -rf:*)",
            "Bash(rm -fr:*)",
            "Bash(git push --force:*)",
            "Bash(git push -f:*)",
            "Bash(git push --force-with-lease:*)",
            "Bash(git reset --hard:*)",
            "Bash(sudo:*)",
            "Bash(npm publish:*)",
            "Edit(.env*)",
            "Edit(**/.env*)",
            "Edit(azure-pipelines*)",
            "Edit(**/azure-pipelines*)",
            "Edit(.claude/settings.json)",
            "Edit(**/docs/design/**)"
        ]
    },
    "model": "sonnet",
    "hooks": {
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node",
                        "args": [
                            "${CLAUDE_PROJECT_DIR}/.claude/hooks/asdd-user-prompt-submit.mjs"
                        ]
                    }
                ]
            }
        ],
        "SubagentStop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node",
                        "args": [
                            "${CLAUDE_PROJECT_DIR}/.claude/hooks/asdd-post-subagent-stop.mjs"
                        ]
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Agent",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node",
                        "args": [
                            "${CLAUDE_PROJECT_DIR}/.claude/hooks/asdd-plan-gate.mjs"
                        ]
                    }
                ]
            },
            {
                "matcher": "Bash|Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node",
                        "args": [
                            "${CLAUDE_PROJECT_DIR}/.claude/hooks/asdd-pre-tool-dispatcher.mjs"
                        ]
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node",
                        "args": [
                            "${CLAUDE_PROJECT_DIR}/.claude/hooks/asdd-session-start-dispatcher.mjs"
                        ]
                    },
                    {
                        "type": "command",
                        "command": "node",
                        "args": [
                            "${CLAUDE_PROJECT_DIR}/.claude/hooks/asdd-run-manifest.mjs"
                        ]
                    }
                ]
            }
        ]
    },
    "worktree": {
        "baseRef": "head"
    },
    "marketplace": {
        "enabledPlugins": []
    }
}
