# ============================================================
# ATF API — Credenciales (TEMPLATE)
# ============================================================
# 1. Copiar este archivo a `credentials.yaml`
# 2. Completar con valores reales por entorno y rol
# 3. NUNCA versionar `credentials.yaml` (está en .gitignore)
#
# Los specs y Gherkin NUNCA contienen credenciales literales,
# solo referencias: {credentials.{ROLE}}
# ============================================================

environments:
  qa:
    base_url: "https://api-qa.example.com/v1"
    roles:
      admin:
        username: "admin@example.com"
        password: "CHANGE-ME"
        token: ""             # opcional — bearer token estático
      standard_user:
        username: "user@example.com"
        password: "CHANGE-ME"
        token: ""

  staging:
    base_url: "https://api-staging.example.com/v1"
    roles:
      admin:
        username: "admin@example.com"
        password: "CHANGE-ME"
        token: ""

  production:
    base_url: "https://api.example.com/v1"
    roles: {}                 # vacío — production NO debería usar credenciales en tests

# --- Headers globales (opcional, aplica a todas las requests) ---
global_headers:
  X-Client-Id: "atf-api-v3"

# --- Secretos de servicios externos (opcional) ---
external_services:
  # zap_proxy:
  #   host: "127.0.0.1"
  #   port: 8080
  #   api_key: "CHANGE-ME"
